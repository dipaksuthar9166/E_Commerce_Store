# Local development (PC browser)
# Keep localhost — when you open the site from a phone via http://192.168.x.x:5173,
# the app auto-rewrites localhost → that same IP so backend still connects.
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Phone testing (optional manual override — only if auto-rewrite fails):
# 1) PC + phone same Wi‑Fi
# 2) Run backend: cd backend && npm run dev  (listens on 0.0.0.0:5000)
# 3) Run frontend: cd frontend && npm run dev  (--host already set)
# 4) On phone open: http://YOUR_PC_IP:5173  (IP printed in backend/frontend terminal)
# VITE_API_URL=http://192.168.1.10:5000/api
# VITE_SOCKET_URL=http://192.168.1.10:5000

# Google Maps — enable Maps JavaScript API, Geocoding API, Places API
# https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=

# Production (also set these in Vercel → Project → Settings → Environment Variables)
# VITE_API_URL=https://YOUR-BACKEND.onrender.com/api
# VITE_SOCKET_URL=https://YOUR-BACKEND.onrender.com
# VITE_GOOGLE_MAPS_API_KEY=your_production_key
