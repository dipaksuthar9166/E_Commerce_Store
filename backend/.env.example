# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:3000

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/mersko

# JSON Web Token
JWT_SECRET=your_strong_jwt_secret_key_here

# Email Configuration (for password reset, etc.)
# You can use a service like Ethereal.email for development,
# or a real SMTP provider (SendGrid, Mailgun) for production.
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USERNAME=your_ethereal_username
EMAIL_PASSWORD=your_ethereal_password
# Cloudinary for Image Management
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS S3 for Bulk Uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=

# AI & External Services
OPENAI_API_KEY=
REMOVE_BG_API_KEY=your_api_key_here

# SMS Provider (e.g., Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
